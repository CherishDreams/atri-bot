{
  "host": "127.0.0.1",
  "port": 6185,
  "logLevel": "info",
  "dataDir": "data",
  "pluginDirs": ["./plugins", "./apps/server/plugins"],
  "adapters": {
    "http": { "enabled": true }
  },
  "providers": {
    "default": "deepseek",
    "deepseek": {
      "type": "openai",
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKey": "换成你自己的密钥，或改用环境变量 ATRI_DEEPSEEK_API_KEY",
      "models": ["deepseek-chat"]
    },
    "claude": {
      "type": "anthropic",
      "apiKey": "",
      "models": ["claude-sonnet-4-5"]
    }
  },
  "staticDir": "apps/dashboard/dist",
  "auth": {
    "adminUser": "admin",
    "cookieName": "atri_session",
    "cookieSecure": false
  }
}
