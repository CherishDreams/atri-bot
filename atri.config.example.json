{
  "host": "127.0.0.1",
  "port": 6185,
  "logLevel": "info",
  "dataDir": "data",
  "pluginDirs": ["./plugins", "./apps/server/plugins"],
  "adapters": {
    "http": { "enabled": true }
  },
  "tools": {
    "current_time": { "enabled": false }
  },
  "providerSources": {
    "deepseek": {
      "type": "openai",
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKey": "换成你自己的密钥，或改用环境变量 ATRI_DEEPSEEK_API_KEY",
      "timeoutMs": 120000
    },
    "claude": {
      "type": "anthropic",
      "apiKey": "",
      "timeoutMs": 120000
    }
  },
  "providers": {
    "default": "deepseek-chat",
    "deepseek-chat": { "source": "deepseek", "model": "deepseek-chat" },
    "claude-sonnet": { "source": "claude", "model": "claude-sonnet-4-5", "enabled": false }
  },
  "staticDir": "apps/dashboard/dist",
  "auth": {
    "adminUser": "admin",
    "cookieName": "atri_session",
    "cookieSecure": false
  }
}
