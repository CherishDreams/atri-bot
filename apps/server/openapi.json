{
  "openapi": "3.1.0",
  "info": {
    "title": "atri-bot API",
    "version": "1.0.0",
    "description": "atri-bot 服务端 HTTP 接口。这是接口契约的唯一来源：\n控制台前端由它生成类型化客户端（@hey-api/openapi-ts），\n服务端的实现必须与它保持一致。\n\n除标注「公开」的接口外，其余都需要登录（HttpOnly Cookie 会话）。"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "与控制台同源"
    }
  ],
  "tags": [
    {
      "name": "health",
      "description": "存活检查"
    },
    {
      "name": "auth",
      "description": "登录鉴权"
    },
    {
      "name": "sessions",
      "description": "会话与消息"
    },
    {
      "name": "plugins",
      "description": "插件管理"
    },
    {
      "name": "providers",
      "description": "模型实例配置"
    },
    {
      "name": "provider-sources",
      "description": "模型供应商连接配置"
    },
    {
      "name": "status",
      "description": "运行时状态"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "存活检查（公开）",
        "tags": ["health"],
        "responses": {
          "200": {
            "description": "服务存活",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "登录（公开）",
        "description": "成功后通过 `Set-Cookie` 下发 HttpOnly 会话 Cookie。\n账号不存在与口令错误返回同一句提示，避免枚举账号。",
        "tags": ["auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "登出（公开，幂等）",
        "description": "未登录时同样返回 200，避免前端卡在登录态。",
        "tags": ["auth"],
        "responses": {
          "200": {
            "description": "已登出",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ok"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "me",
        "summary": "当前登录用户",
        "tags": ["auth"],
        "responses": {
          "200": {
            "description": "当前会话",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/status": {
      "get": {
        "operationId": "authStatus",
        "summary": "是否需要登录（公开）",
        "description": "必须在渲染登录页之前可访问，否则前端无从得知要不要登录。",
        "tags": ["auth"],
        "responses": {
          "200": {
            "description": "鉴权是否启用",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["required"],
                  "properties": {
                    "required": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sessions": {
      "get": {
        "operationId": "listSessions",
        "summary": "列出会话（仅摘要，不含消息）",
        "tags": ["sessions"],
        "responses": {
          "200": {
            "description": "会话列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["sessions"],
                  "properties": {
                    "sessions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Session"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "operationId": "createSession",
        "summary": "创建会话",
        "tags": ["sessions"],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "已创建",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["session"],
                  "properties": {
                    "session": {
                      "$ref": "#/components/schemas/Session"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/sessions/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/SessionId"
        }
      ],
      "get": {
        "operationId": "getSession",
        "summary": "读取会话详情（含完整消息历史）",
        "tags": ["sessions"],
        "responses": {
          "200": {
            "description": "会话详情",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["session"],
                  "properties": {
                    "session": {
                      "$ref": "#/components/schemas/SessionDetail"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "operationId": "deleteSession",
        "summary": "删除会话",
        "tags": ["sessions"],
        "responses": {
          "200": {
            "description": "已删除",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["deleted"],
                  "properties": {
                    "deleted": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/sessions/{id}/messages": {
      "parameters": [
        {
          "$ref": "#/components/parameters/SessionId"
        }
      ],
      "post": {
        "operationId": "sendMessage",
        "summary": "发送用户消息并等待完整回复",
        "tags": ["sessions"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMessageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "助手回复",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["message"],
                  "properties": {
                    "message": {
                      "$ref": "#/components/schemas/Message"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/sessions/{id}/messages/stream": {
      "parameters": [
        {
          "$ref": "#/components/parameters/SessionId"
        }
      ],
      "post": {
        "operationId": "streamMessage",
        "summary": "发送用户消息并以 SSE 流式接收回复",
        "description": "响应为 `text/event-stream`。每个事件的 data 是一个 JSON 对象：\n`{\"delta\": \"...\", \"done\": false}` 表示增量文本，\n末帧为 `{\"delta\": \"\", \"done\": true}`。\n\n注意：provider 出错时 HTTP 状态码已经是 200（响应头早已发出），\n错误通过 `{\"error\": \"...\"}` 事件传递，而不是靠状态码。",
        "tags": ["sessions"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMessageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "增量事件流",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/StreamChunk"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/providers": {
      "get": {
        "operationId": "listProviders",
        "summary": "列出模型实例（配置层）",
        "description": "返回配置里的**全部** provider 条目，并标注它有没有真正加载成功。\n与旧版「只返回运行时已注册的」不同：配置页需要看得见「我配了但它没生效」。",
        "tags": ["providers"],
        "responses": {
          "200": {
            "description": "provider 列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["providers"],
                  "properties": {
                    "providers": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ProviderInfo"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "operationId": "createProvider",
        "summary": "新建模型实例",
        "description": "保存后立即重建注册表，不需要重启。",
        "tags": ["providers"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "已创建",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["provider"],
                  "properties": {
                    "provider": {
                      "$ref": "#/components/schemas/ProviderInfo"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/providers/{id}": {
      "post": {
        "operationId": "updateProvider",
        "summary": "局部更新模型实例",
        "description": "只覆盖请求体里出现的字段。`{\"default\": true}` 即把它设为默认；\n`{\"default\": false}` 只在它本来就是默认项时才清掉。",
        "tags": ["providers"],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProviderId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已更新",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["provider"],
                  "properties": {
                    "provider": {
                      "$ref": "#/components/schemas/ProviderInfo"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "operationId": "deleteProvider",
        "summary": "删除模型实例",
        "description": "删掉的若是默认项，`providers.default` 会被一并清空，选路退回第一个可用项。",
        "tags": ["providers"],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProviderId"
          }
        ],
        "responses": {
          "200": {
            "description": "已删除",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Deleted"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/provider-sources": {
      "get": {
        "operationId": "listProviderSources",
        "summary": "列出供应商源",
        "description": "**明文返回 `apiKey`**：配置页要能把原值填回输入框，这是有意的取舍。\n该接口在鉴权闸门之内，仅管理员可取。",
        "tags": ["provider-sources"],
        "responses": {
          "200": {
            "description": "源列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["sources"],
                  "properties": {
                    "sources": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ProviderSource"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "operationId": "createProviderSource",
        "summary": "新建供应商源",
        "tags": ["provider-sources"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderSourceInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "已创建",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["source"],
                  "properties": {
                    "source": {
                      "$ref": "#/components/schemas/ProviderSource"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/provider-sources/{id}": {
      "post": {
        "operationId": "updateProviderSource",
        "summary": "局部更新供应商源",
        "description": "不支持改 id：源创建后 id 只读，避免 AstrBot 那种「改名要重写全部引用者」的复杂度。",
        "tags": ["provider-sources"],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProviderSourceId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderSourceUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已更新",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["source"],
                  "properties": {
                    "source": {
                      "$ref": "#/components/schemas/ProviderSource"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "operationId": "deleteProviderSource",
        "summary": "删除供应商源",
        "description": "仍被 provider 引用时默认拒绝（400，消息里列出引用者），避免静默级联把\n用户配好的模型悄悄删掉；`?cascade=1` 才连带删除引用者。",
        "tags": ["provider-sources"],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProviderSourceId"
          },
          {
            "name": "cascade",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "为真时连带删除引用该源的 provider"
          }
        ],
        "responses": {
          "200": {
            "description": "已删除，`deleted` 是源 id 与连带删除的 provider id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeletedMany"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/provider-sources/{id}/models": {
      "post": {
        "operationId": "fetchProviderModels",
        "summary": "获取该源可用的模型列表",
        "description": "用**已保存的**源去打上游的 `GET /models`。刻意不接受请求体里的\n`baseUrl`/`apiKey`：否则这个端点会变成「带任意凭证访问任意地址」的转发器。\n用户要先保存，再获取——与界面上的「保存并获取模型列表」同一语义。\n上游没有 `/models` 时返回 400 与可读提示，可由「自定义模型」手填绕过。",
        "tags": ["provider-sources"],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProviderSourceId"
          }
        ],
        "responses": {
          "200": {
            "description": "模型列表，已去重并按字典序排序",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderModelList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/plugins": {
      "get": {
        "operationId": "listPlugins",
        "summary": "列出插件",
        "tags": ["plugins"],
        "responses": {
          "200": {
            "description": "插件列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["plugins"],
                  "properties": {
                    "plugins": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PluginInfo"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/plugins/{id}/reload": {
      "parameters": [
        {
          "$ref": "#/components/parameters/PluginId"
        }
      ],
      "post": {
        "operationId": "reloadPlugin",
        "summary": "重载插件（销毁旧实例并重新求值代码）",
        "tags": ["plugins"],
        "responses": {
          "200": {
            "description": "重载后的插件状态",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["plugin"],
                  "properties": {
                    "plugin": {
                      "$ref": "#/components/schemas/PluginInfo"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/plugins/{id}/unload": {
      "parameters": [
        {
          "$ref": "#/components/parameters/PluginId"
        }
      ],
      "post": {
        "operationId": "unloadPlugin",
        "summary": "卸载插件（释放副作用并移除）",
        "tags": ["plugins"],
        "responses": {
          "200": {
            "description": "卸载结果",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "unloaded"],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "unloaded": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/plugins/{id}/enable": {
      "parameters": [
        {
          "$ref": "#/components/parameters/PluginId"
        }
      ],
      "post": {
        "operationId": "setPluginEnabled",
        "summary": "启用 / 禁用插件",
        "tags": ["plugins"],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新后的插件状态",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["plugin"],
                  "properties": {
                    "plugin": {
                      "$ref": "#/components/schemas/PluginInfo"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/adapters": {
      "get": {
        "operationId": "listAdapters",
        "summary": "列出平台适配器",
        "tags": ["status"],
        "responses": {
          "200": {
            "description": "适配器列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["adapters"],
                  "properties": {
                    "adapters": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AdapterInfo"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "SessionId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "会话 id"
      },
      "PluginId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "插件 id"
      },
      "ProviderId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "provider 实例 id"
      },
      "ProviderSourceId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "provider source id"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "请求无效",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "未登录或会话已失效",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "NotFound": {
        "description": "资源不存在",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Ok": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": ["ok", "app", "version"],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "app": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "AuthUser": {
        "type": "object",
        "required": ["username"],
        "properties": {
          "username": {
            "type": "string"
          }
        }
      },
      "AuthSession": {
        "type": "object",
        "required": ["user", "expiresAt"],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthUser"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Role": {
        "type": "string",
        "enum": ["system", "user", "assistant", "tool"]
      },
      "Message": {
        "type": "object",
        "required": ["id", "sessionId", "role", "content", "createdAt"],
        "properties": {
          "id": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "content": {
            "type": "string"
          },
          "toolCallId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": ["id", "title", "createdAt", "updatedAt"],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "messageCount": {
            "type": "integer"
          }
        }
      },
      "SessionDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Session"
          },
          {
            "type": "object",
            "required": ["messages"],
            "properties": {
              "messages": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          }
        ]
      },
      "SendMessageRequest": {
        "type": "object",
        "required": ["content"],
        "properties": {
          "content": {
            "type": "string",
            "description": "用户消息正文"
          },
          "model": {
            "type": "string",
            "description": "指定模型；留空则用 provider 配置里的默认值，没有默认值时取第一个 provider"
          }
        }
      },
      "StreamChunk": {
        "type": "object",
        "properties": {
          "delta": {
            "type": "string",
            "description": "本次增量文本"
          },
          "done": {
            "type": "boolean",
            "description": "是否为末帧"
          },
          "message": {
            "$ref": "#/components/schemas/Message",
            "description": "末帧带回已落库的助手消息"
          },
          "error": {
            "type": "string",
            "description": "流中途出错时的可读提示"
          }
        }
      },
      "ProviderInfo": {
        "type": "object",
        "required": ["id", "name"],
        "description": "配置层的一个模型实例。`loaded` 说明它有没有真正注册进运行时。",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "model": {
            "type": "string",
            "description": "上游的模型 ID"
          },
          "source": {
            "type": "string",
            "description": "引用的 provider source id；内联老写法下没有这个字段"
          },
          "type": {
            "type": "string",
            "description": "provider 实现类型，如 openai / anthropic"
          },
          "enabled": {
            "type": "boolean",
            "description": "是否启用；禁用的实例不出现在模型选择器里"
          },
          "default": {
            "type": "boolean",
            "description": "是否为配置里的默认 provider"
          },
          "loaded": {
            "type": "boolean",
            "description": "是否已成功注册进运行时"
          },
          "error": {
            "type": "string",
            "description": "加载失败的原因；只有 `loaded` 为 false 时才有"
          }
        }
      },
      "ProviderInput": {
        "type": "object",
        "required": ["id", "model"],
        "properties": {
          "id": {
            "type": "string",
            "description": "只允许字母、数字、点、下划线与连字符；不能是保留键 default"
          },
          "model": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean",
            "description": "缺省为 true"
          },
          "default": {
            "type": "boolean"
          }
        }
      },
      "ProviderUpdate": {
        "type": "object",
        "description": "只覆盖出现的字段",
        "properties": {
          "model": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "default": {
            "type": "boolean"
          }
        }
      },
      "ProviderSource": {
        "type": "object",
        "required": ["id", "type"],
        "description": "一次连接的描述：同一源下的多个模型共享这里的凭证与超时。",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "openai 或 anthropic"
          },
          "name": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string",
            "description": "空则用实现类的默认值"
          },
          "apiKey": {
            "type": "string",
            "description": "明文返回，见接口说明"
          },
          "timeoutMs": {
            "type": "integer",
            "description": "毫秒，1000 至 600000"
          }
        }
      },
      "ProviderSourceInput": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "缺省为 openai"
          },
          "name": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "apiKey": {
            "type": "string"
          },
          "timeoutMs": {
            "type": "integer"
          }
        }
      },
      "ProviderSourceUpdate": {
        "type": "object",
        "description": "只覆盖出现的字段；不支持改 id",
        "properties": {
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "apiKey": {
            "type": "string"
          },
          "timeoutMs": {
            "type": "integer"
          }
        }
      },
      "ProviderModelList": {
        "type": "object",
        "required": ["models"],
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Deleted": {
        "type": "object",
        "required": ["deleted"],
        "properties": {
          "deleted": {
            "type": "string"
          }
        }
      },
      "DeletedMany": {
        "type": "object",
        "required": ["deleted"],
        "properties": {
          "deleted": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AdapterInfo": {
        "type": "object",
        "required": ["id", "name", "enabled"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "PluginStatus": {
        "type": "string",
        "enum": ["active", "disabled"],
        "description": "插件运行时状态。active=运行中，disabled=已禁用（保留元数据可再启用）。"
      },
      "PluginInfo": {
        "type": "object",
        "required": ["id", "name", "enabled"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean",
            "description": "当前是否在接收事件（等价于 status === \"active\"）"
          },
          "status": {
            "$ref": "#/components/schemas/PluginStatus"
          },
          "dir": {
            "type": "string",
            "description": "插件所在目录名，便于在控制台辨认"
          },
          "error": {
            "type": "string",
            "description": "加载失败时的可读原因"
          }
        }
      }
    }
  }
}
