# atri-bot 服务端配置。
# 复制为 .env 后按需修改。结构性设置也可放在 atri.config.json 中；
# 环境变量的优先级高于配置文件。

# 服务监听地址（默认 127.0.0.1:6185）
ATRI_HOST=127.0.0.1
ATRI_PORT=6185

# debug | info | warn | error
ATRI_LOG_LEVEL=info

# 运行时数据目录：会话与消息库 sessions.sqlite 落在这里（相对 ATRI_ROOT 解析）
ATRI_DATA_DIR=data

# 用于解析配置文件、插件目录与数据目录的项目根目录。
# 默认是本仓库的根目录，由源文件位置推出 —— 与「从哪个目录启动」无关
# （从前默认是当前工作目录，而 pnpm --filter 会把 cwd 切成 apps/server/，
#  于是同一个部署长出两套配置与 data/）。
# ATRI_ROOT=/path/to/atri-bot

# ===== 登录鉴权 =====
# 控制台使用单一管理员账号。这些值不配也能跑：
# 未设置 ATRI_ADMIN_PASSWORD 时，服务端会生成一个随机口令、
# 写进 atri.config.json 的 auth.adminPassword，并在启动日志里打印一次。
# ATRI_ADMIN_USER=admin
# ATRI_ADMIN_PASSWORD=换成你自己的口令

# 承载登录会话的 Cookie 名（默认 atri_session）
# ATRI_COOKIE_NAME=atri_session

# 勾选后 Cookie 带 Secure 属性，仅在 HTTPS 下可用。
# 本仓默认明文 HTTP，所以默认关闭；部署在 HTTPS 反向代理后面时设为 1。
# ATRI_COOKIE_SECURE=1

# 控制台构建产物目录（服务端托管它并做 SPA 回退，默认 apps/dashboard/dist）
# ATRI_STATIC_DIR=apps/dashboard/dist

# ===== 模型 provider 密钥 =====
# 变量名规则：ATRI_<SOURCE_ID>_API_KEY，其中 SOURCE_ID 会转成大写、
# 非字母数字字符换成下划线。所以 providerSources 里叫 deepseek 的源就读
# ATRI_DEEPSEEK_API_KEY，叫 my-gateway 的就读 ATRI_MY_GATEWAY_API_KEY。
# 密钥属于「源」而不是单个模型：同一个源下的所有模型共用一份凭证。
# 环境变量优先于配置档文件里的 apiKey，便于容器部署时把密钥留在文件之外。
#
# 这里**没有**配置档维度（不是 ATRI_<PROFILE>_<SOURCE>_API_KEY）：凭证属于连接，
# 一个 DeepSeek 账号同时服务多份配置档正是常见期望。要两份配置档用**不同**密钥，
# 就给它们**不同的 source id**（deepseek-work / deepseek-home），各配一条环境变量。
# ATRI_DEEPSEEK_API_KEY=sk-...
# ATRI_MY_GATEWAY_API_KEY=sk-...
