# atri-bot 服务端配置。
# 复制为 .env 后按需修改。结构性设置也可放在 atri.config.json 中；
# 环境变量的优先级高于配置文件。

# 服务监听地址（默认 127.0.0.1:6185）
ATRI_HOST=127.0.0.1
ATRI_PORT=6185

# debug | info | warn | error
ATRI_LOG_LEVEL=info

# 运行时数据目录（会话库、上传文件等）
ATRI_DATA_DIR=data

# 用于解析配置文件和插件目录的项目根目录（默认：当前工作目录）
# ATRI_ROOT=/path/to/atri-bot
