{
  "name": "atri-bot",
  "version": "1.0.0",
  "private": true,
  "description": "atri-bot —— 可扩展的 agent 平台（服务端 + 控制台）",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @atri/server dev",
    "dev:dashboard": "pnpm --filter @atri/dashboard dev",
    "start": "pnpm --filter @atri/server start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "codegen": "openapi-ts -f openapi-ts.config.ts",
    "codegen:check": "pnpm codegen && node scripts/check-codegen.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm static:check && pnpm codegen:check && pnpm test",
    "clean": "node scripts/clean.mjs",
    "static:check": "node scripts/check-layering.mjs && node scripts/check-refs.mjs && node scripts/check-tool-registry.mjs"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^22.10.2",
    "@types/ws": "8.18.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.11.2"
}
