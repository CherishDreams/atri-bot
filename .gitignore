# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
build/
*.tsbuildinfo

# unplugin-auto-import / unplugin-vue-components 的产物：
# 每次 dev 和 build 都会重写，且内容里自带 /* oxfmt-ignore */（oxfmt 并不认这条注释），
# 入库只会制造无意义的格式噪声。
apps/dashboard/auto-imports.d.ts
apps/dashboard/components.d.ts

# 日志
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# 环境变量 / 密钥
.env
.env.*
!.env.example

# 本地配置：未配置管理员密码时会把自动生成的口令写进这里，绝不能入库
atri.config.json
# 原子写的临时文件（`writeConfigFileAt` 先写 `<目标>.tmp` 再 rename）。正常路径下它不会存在，
# 但一次失败的写或掉电会把它留在原地 —— 而它里面是**完整的**口令与明文密钥。
# 这里必须显式忽略：本文件忽略的是**精确名** `atri.config.json`，多个 `.tmp` 就成了
# 「未跟踪但也不忽略」，一次顺手 `git add -A` 就把口令提交进版本库。
atri.config.json.tmp

# 运行时数据与本地状态
data/
*.sqlite
*.sqlite-journal
# WAL 模式的两个边车文件（会话库用 WAL；`data/` 已经盖住默认 dataDir，
# 这两行是给 `ATRI_DATA_DIR` 指到别处时兜底）。`-journal` 那行保留：文件系统不支持
# WAL 时 SQLite 会退回 delete journal，名字不一样。
*.sqlite-wal
*.sqlite-shm
*.db

# 编辑器 / 操作系统
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# ZCode 工作区工具文件（不入库）
.zcodeignore
.zcode/

# 测试 / 覆盖率
coverage/
