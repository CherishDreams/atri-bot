{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortPackageJson": true,
  "sortImports": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "pnpm-lock.yaml",
    "*.min.js",
    "apps/dashboard/src/api/generated"
  ]
}
